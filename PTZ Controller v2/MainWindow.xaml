<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PTZ_Controller_v2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PTZ_Controller_v2"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"     Title="PTZ Controller v2">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Style="{StaticResource HeaderBorderStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="14">

                <Ellipse Style="{StaticResource PrimaryStatusDotStyle}"/>

                <TextBlock Text="PTZ CONTROL"
                           Style="{StaticResource AppTitleTextStyle}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"  Orientation="Horizontal"   Spacing="12">

                <Button Content="CONTROL HUB"  Style="{StaticResource DarkButtonStyle}"  Click="OpenControlHub_Click"/>

                <Button Content="+ ADD CAMERA"  Style="{StaticResource HeaderButtonStyle}"  Click="AddCamera_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="{StaticResource BodyPadding}"
                        Spacing="34">

                <!-- Summary Cards -->
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="TOTAL CAMERAS"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="3"
                                       Style="{StaticResource NumberStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="ONLINE"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="2"
                                       Style="{StaticResource PrimaryNumberStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="OFFLINE"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBlock Text="1"
                                       Style="{StaticResource DangerNumberStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Text="CAMERA FEEDS"
                           Style="{StaticResource SectionTitleStyle}"/>

                <!-- Camera Cards -->
                <GridView x:Name="CameraGridView"
          ItemsSource="{x:Bind Cameras, Mode=OneWay}"
          IsItemClickEnabled="False"
          SelectionMode="None">

                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal"
                           MaximumRowsOrColumns="2"/>
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>

                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,24,24"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </GridView.ItemContainerStyle>

                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:CameraCardViewModel">

                            <Border Style="{StaticResource CameraCardStyle}"
                    Width="520">

                                <StackPanel Spacing="20">

                                    <!-- Camera Header -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">

                                            <Ellipse Style="{StaticResource PrimaryStatusDotStyle}"/>

                                            <TextBlock Text="{x:Bind CameraName}"
                                       Style="{StaticResource CameraNameTextStyle}"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource OnlineStatusBadgeStyle}">
                                            <TextBlock Text="Saved"
                                       Style="{StaticResource OnlineStatusTextStyle}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Camera Details -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Address" Style="{StaticResource DetailLabelStyle}"/>
                                            <TextBlock Text="Protocol" Style="{StaticResource DetailLabelStyle}"/>
                                            <TextBlock Text="User" Style="{StaticResource DetailLabelStyle}"/>
                                            <TextBlock Text="Video" Style="{StaticResource DetailLabelStyle}"/>
                                            <TextBlock Text="Preview" Style="{StaticResource DetailLabelStyle}"/>
                                            <TextBlock Text="Tracking" Style="{StaticResource DetailLabelStyle}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                    Spacing="8"
                                    HorizontalAlignment="Right">

                                            <StackPanel Grid.Column="1"
            Spacing="8"
            HorizontalAlignment="Right">

                                                <TextBlock Text="{x:Bind IP}"
               Style="{StaticResource DetailValueStyle}"/>

                                                <TextBlock Text="{x:Bind Protocol}"
               Style="{StaticResource DetailValueStyle}"/>

                                                <TextBlock Text="{x:Bind UserId}"
               Style="{StaticResource DetailValueStyle}"/>

                                               

                                                <TextBlock Text="{x:Bind PreviewStreamStatus}"
               Style="{StaticResource DetailValueStyle}"/>

                                                <TextBlock Text="{x:Bind TrackingStreamStatus}"
               Style="{StaticResource DetailValueStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Buttons -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="64"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Content="CONTROL"
                                Style="{StaticResource ControlButtonStyle}"
                                Click="ControlCamera_Click"
                                Tag="{x:Bind}"/>

                                        <Button Grid.Column="1"
                                Content="Edit"
                                Style="{StaticResource DarkButtonStyle}"
                                Tag="{x:Bind}"/>

                                        <Button Grid.Column="2"
                                Content="Del"
                                Style="{StaticResource DeleteButtonStyle}"
                                Click="DeleteCamera_Click"
                                Tag="{x:Bind}"/>
                                    </Grid>

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>