<Window
    x:Class="PTZ_Controller_v2.CameraControlWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   
    Closed="Window_Closed"    
    Title="Camera Control">

    <Grid  RequestedTheme="Dark" Background="{StaticResource AppBackgroundBrush}"
          Padding="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource CardStyle}"
                Margin="0,0,0,20">

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="CameraNameTextBlock"
                               Style="{StaticResource AppTitleTextStyle}"/>

                    <TextBlock x:Name="CameraIpTextBlock"
                               Style="{StaticResource DetailLabelStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="12"
                            VerticalAlignment="Center">

                    <Border x:Name="ConnectionStatusBadge"
                            Style="{StaticResource OfflineStatusBadgeStyle}">
                        <TextBlock x:Name="ConnectionStatusTextBlock"
                                   Text="Disconnected"
                                   Style="{StaticResource OfflineStatusTextStyle}"/>
                    </Border>

                    <Button x:Name="ConnectButton"
                            Content="CONNECT"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Connect_Click"/>

                    <Button x:Name="DisconnectButton"
                            Content="DISCONNECT"
                            Style="{StaticResource DarkButtonStyle}"
                            Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1"
              ColumnSpacing="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Video Preview -->
            <Border Grid.Column="0"
                    Style="{StaticResource CameraCardStyle}">

                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#05070A"
                            CornerRadius="12">

                        <MediaPlayerElement x:Name="PreviewPlayer"
                                            AreTransportControlsEnabled="False"
                                            AutoPlay="False"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnSpacing="12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="VIDEO PREVIEW"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <TextBlock x:Name="VideoStreamTextBlock"
                                       Style="{StaticResource DetailLabelStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="RELOAD"
                                Style="{StaticResource DarkButtonStyle}"
                                Click="ReloadPreview_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Controls -->
            <!-- Right Controls -->
           <TabView Grid.Column="1"
         Style="{StaticResource DarkTabViewStyle}"
         IsAddTabButtonVisible="False"
         CanDragTabs="False" TabWidthMode="Equal">

                <!-- PTZ TAB -->
                <TabViewItem Header="PTZ"
             IsClosable="False" Style="{StaticResource DarkTabViewItemStyle}">

                    <Grid Padding="0,8,0,0">
                        <StackPanel Spacing="12">

                            <Border Style="{StaticResource CompactCameraCardStyle}">
                                <StackPanel Spacing="14">

                                    <TextBlock Text="PTZ CONTROL"
                               Style="{StaticResource SectionTitleStyle}"/>

                                    <Grid HorizontalAlignment="Center"
                          RowSpacing="7"
                          ColumnSpacing="7">

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Row="0" Grid.Column="0"
                                Content="↖"
                                Style="{StaticResource CompactPadButtonStyle}"
                                Click="UpLeft_Click"/>

                                        <Button Grid.Row="0" Grid.Column="1"
                                Content="▲"
                                Style="{StaticResource CompactPadPrimaryButtonStyle}"
                                Click="TiltUp_Click"/>

                                        <Button Grid.Row="0" Grid.Column="2"
                                Content="↗"
                                Style="{StaticResource CompactPadButtonStyle}"
                                Click="UpRight_Click"/>

                                        <Button Grid.Row="1" Grid.Column="0"
                                Content="◀"
                                Style="{StaticResource CompactPadPrimaryButtonStyle}"
                                Click="PanLeft_Click"/>

                                        <Button Grid.Row="1" Grid.Column="1"
                                Content="●"
                                Style="{StaticResource CompactPadStopButtonStyle}"
                                Click="Stop_Click"/>

                                        <Button Grid.Row="1" Grid.Column="2"
                                Content="▶"
                                Style="{StaticResource CompactPadPrimaryButtonStyle}"
                                Click="PanRight_Click"/>

                                        <Button Grid.Row="2" Grid.Column="0"
                                Content="↙"
                                Style="{StaticResource CompactPadButtonStyle}"
                                Click="DownLeft_Click"/>

                                        <Button Grid.Row="2" Grid.Column="1"
                                Content="▼"
                                Style="{StaticResource CompactPadPrimaryButtonStyle}"
                                Click="TiltDown_Click"/>

                                        <Button Grid.Row="2" Grid.Column="2"
                                Content="↘"
                                Style="{StaticResource CompactPadButtonStyle}"
                                Click="DownRight_Click"/>
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                Content="ZOOM -"
                                Style="{StaticResource DarkButtonStyle}"
                                Click="ZoomOut_Click"/>

                                        <Button Grid.Column="1"
                                Content="STOP"
                                Style="{StaticResource DeleteButtonStyle}"
                                Click="ZoomStop_Click"/>

                                        <Button Grid.Column="2"
                                Content="ZOOM +"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ZoomIn_Click"/>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Pan Speed"
                                       Style="{StaticResource DetailLabelStyle}"/>
                                            <Slider x:Name="PanSpeedSlider"
                                    Minimum="1"
                                    Maximum="24"
                                    Value="10"
                                    ValueChanged="PanSpeedSlider_ValueChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                    Spacing="4">
                                            <TextBlock Text="Tilt Speed"
                                       Style="{StaticResource DetailLabelStyle}"/>
                                            <Slider x:Name="TiltSpeedSlider"
                                    Minimum="1"
                                    Maximum="20"
                                    Value="10"
                                    ValueChanged="TiltSpeedSlider_ValueChanged"/>
                                        </StackPanel>
                                    </Grid>

                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CompactCameraCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="STATUS"
                               Style="{StaticResource SectionTitleStyle}"/>

                                    <TextBlock x:Name="StatusTextBlock"
                               Text="Ready"
                               Style="{StaticResource DetailValueStyle}"
                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>
                </TabViewItem>

                <!-- IMAGE SETTINGS TAB -->
                <TabViewItem Header="Image"
             IsClosable="False" Style="{StaticResource DarkTabViewItemStyle}">

                    <Grid Padding="0,8,0,0">

                        <Border Style="{StaticResource CompactCameraCardStyle}">
                            <StackPanel Spacing="16">

                                <TextBlock Text="IMAGE SETTINGS"
                           Style="{StaticResource SectionTitleStyle}"/>

                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Exposure -->
                                    <StackPanel Spacing="10">

                                        <TextBlock Text="EXPOSURE"
                                   Style="{StaticResource LabelStyle}"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Mode"
                                       Style="{StaticResource DetailLabelStyle}"/>

                                            <ComboBox x:Name="ExposureModeComboBox"
                                      MinWidth="180"
                                      SelectionChanged="ExposureModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="FullAuto"/>
                                                <ComboBoxItem Content="Manual"/>
                                                <ComboBoxItem Content="ShutterPriority"/>
                                                <ComboBoxItem Content="IrisPriority"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Gain"
                                       Style="{StaticResource DetailLabelStyle}"/>

                                            <Slider x:Name="GainSlider"
                                    Minimum="0"
                                    Maximum="15"
                                    Value="0"
                                    ValueChanged="GainSlider_ValueChanged"/>

                                            <TextBlock x:Name="GainValueTextBlock"
                                       Text="Gain: 0"
                                       Style="{StaticResource DetailValueStyle}"/>
                                        </StackPanel>

                                    </StackPanel>

                                    <!-- White Balance -->
                                    <StackPanel Grid.Column="1"
                                Spacing="10">

                                        <TextBlock Text="WHITE BALANCE"
                                   Style="{StaticResource LabelStyle}"/>

                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Mode"
                                       Style="{StaticResource DetailLabelStyle}"/>

                                            <ComboBox x:Name="WhiteBalanceModeComboBox"
                                      MinWidth="180"
                                      SelectionChanged="WhiteBalanceModeComboBox_SelectionChanged">
                                                <ComboBoxItem Content="Auto"/>
                                                <ComboBoxItem Content="Indoor"/>
                                                <ComboBoxItem Content="Outdoor"/>
                                                <ComboBoxItem Content="OnePush"/>
                                                <ComboBoxItem Content="Manual"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <CheckBox x:Name="AutoWhiteBalanceCheckBox"
                                  Content="Auto White Balance"
                                  Foreground="{StaticResource WhiteTextBrush}"
                                  Checked="AutoWhiteBalanceCheckBox_Checked"
                                  Unchecked="AutoWhiteBalanceCheckBox_Unchecked"/>

                                    </StackPanel>
                                </Grid>

                            </StackPanel>
                        </Border>

                    </Grid>
                </TabViewItem>

                <!-- FUTURE TRACKING TAB -->
                <TabViewItem Header="Tracking"
             IsClosable="False" Style="{StaticResource DarkTabViewItemStyle}">

                    <Grid Padding="0,8,0,0">
                        <Border Style="{StaticResource CompactCameraCardStyle}">
                            <StackPanel Spacing="12">

                                <TextBlock Text="AUTO TRACKING"
                           Style="{StaticResource SectionTitleStyle}"/>

                                <TextBlock Text="Tracking controls will be added here later."
                           Style="{StaticResource DetailLabelStyle}"
                           TextWrapping="Wrap"/>

                                <TextBlock Text="Future options: subject detection, dead zone, tracking speed, smoothing, and OpenCV status."
                           Style="{StaticResource DetailLabelStyle}"
                           TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>
                    </Grid>
                </TabViewItem>

            </TabView>
        </Grid>
    </Grid>
</Window>